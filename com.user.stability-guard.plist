<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.stability-guard</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__SCRIPT__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- If the daemon ever crashes on startup, do not let launchd respawn it
         in a tight loop: wait 30 s between attempts. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- launchd НЕ наследует переменные из шелла. Всё нужное задаётся здесь. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/.local/share/stability-guard/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/share/stability-guard/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
